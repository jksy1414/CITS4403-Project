# ============================
# Python cache and environments
# ============================
__pycache__/
*.py[cod]
*.egg
*.egg-info/
*.pyo
*.so
.venv/
venv/
env/

# ============================
# IDE / Editor settings
# ============================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ============================
# Jupyter Notebooks
# ============================
.ipynb_checkpoints/

# ============================
# Data / Results
# ============================

# Ignore everything in data by default
data/**

# --- Allow runs (JSON, CSV)
!data/runs/
!data/runs/**/*.json
!data/runs/**/*.csv
!data/runs/**/README.md

# --- Allow figures and metrics
!data/figures/
!data/figures/**/*.png
!data/figures/**/*.jpg
!data/figures/**/*.jpeg
!data/figures/**/*.xlsx
!data/figures/**/*.csv

# ============================
# Miscellaneous
# ============================
*.tmp
*.log
*.bak
