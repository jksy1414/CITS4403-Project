# ============================
# Python cache and environments
# ============================
__pycache__/
*.py[cod]
*.egg
*.egg-info/
*.pyo
*.so
.venv/
venv/
env/

# ============================
# IDE / Editor settings
# ============================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ============================
# Jupyter Notebooks
# ============================
.ipynb_checkpoints/

# ============================
# Data / Results
# ============================

# --- Ignore all raw or temporary binary data formats
data/**/*.npy
data/**/*.npz
data/**/*.pkl
data/**/*.log
data/**/*.tmp
data/**/*.zip
data/**/*.bin
data/**/*.bak

# ✅ Keep everything else under /data (plots, metrics, JSON, CSV, etc.)
!data/
!data/**/
!data/**/*.json
!data/**/*.csv
!data/**/*.xlsx
!data/**/*.png
!data/**/*.jpg
!data/**/*.jpeg
!data/**/README.md

# ============================
# Miscellaneous
# ============================
*.tmp
*.log
*.bak
