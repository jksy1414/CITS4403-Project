# ============================
# Data / results
# ============================
# Ignore everything by default…
data/**

# …but allow these dirs so child rules can apply
!data/
!data/runs/
!data/runs/ca/

# Keep ALL results under data/runs/ca (any naming pattern)
!data/runs/ca/**/*.csv
!data/runs/ca/**/*.json
!data/**/README.md

# Still ignore heavy/binary caches anywhere
data/**/*.npz
data/**/*.npy
data/**/*.pkl
data/**/*.log
data/**/*.tmp
data/**/*.zip
