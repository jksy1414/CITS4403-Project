# ============================
# Data / results
# ============================
# Ignore everything by default…
data/**

# …but allow these dirs so child rules can apply
!data/
!data/runs/
!data/runs/ca/

# Always keep summaries (needed for marking)
!data/**/summary.csv
!data/**/summary.json
!data/**/README.md

# Keep all reasonable sample of per-run JSONs (00–29)
!data/**/CA_run_*.json

# Still ignore heavy/binary caches
data/**/*.npz
data/**/*.npy
data/**/*.pkl
data/**/*.log
data/**/*.tmp
data/**/*.zip
