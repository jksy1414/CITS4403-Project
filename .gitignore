# ============================
# Python cache and environments
# ============================
__pycache__/
*.py[cod]
*.egg
*.egg-info/
*.pyo
*.so
.venv/
venv/
env/

# ============================
# IDE / Editor settings
# ============================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ============================
# Jupyter Notebooks
# ============================
.ipynb_checkpoints/

# ============================
# Data / Results
# ============================
# Ignore everything in data by default
data/**

# Keep these folders so we can allow specific file types
!data/
!data/runs/
!data/runs/**/
!data/figures/

# ✅ Keep all simulation results (.json and .csv) under data/runs/
!data/runs/**/*.json
!data/runs/**/*.csv
!data/runs/**/README.md

# Still ignore heavy or binary artifacts
data/**/*.npz
data/**/*.npy
data/**/*.pkl
data/**/*.log
data/**/*.tmp
data/**/*.zip
data/**/*.bak
data/**/*.bin

# ============================
# Miscellaneous
# ============================
*.tmp
*.log
*.bak
